<div
  id="kfo-product-fav-btn"
  data-handle="{{ product.handle | escape }}"
  data-product-id="{{ product.id }}"
  data-title="{{ product.title | escape }}"
  data-image="{{ product.featured_image | image_url: width: 400 | escape }}"
  data-heart-url="{{ 'kfo-heart.svg' | asset_url }}"
  data-heart-active-url="{{ 'kfo-heart-active.svg' | asset_url }}"
  {{ block.shopify_attributes }}
></div>

{{ 'kfo-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kfo-product-favorites.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KFO Product Favorite",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Adds a heart button that lets customers save this product to their favorites. No configuration needed — works automatically."
    }
  ]
}
{% endschema %}
