{% if block.settings.algolia_app_id != blank and block.settings.algolia_search_key != blank %}
  <div
    id="kfo-favorites"
    data-app-id="{{ block.settings.algolia_app_id | escape }}"
    data-search-key="{{ block.settings.algolia_search_key | escape }}"
    data-combinations-index="{{ block.settings.combinations_index | default: 'kfo_combinations' | escape }}"
    data-heart-url="{{ 'kfo-heart.svg' | asset_url }}"
    data-heart-active-url="{{ 'kfo-heart-active.png' | asset_url }}"
    {{ block.shopify_attributes }}
  ></div>

  {{ 'kfo-widget.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'kfo-favorites.js' | asset_url }}" defer></script>
{% else %}
  <p style="color: #bf0711; padding: 16px; border: 1px solid #bf0811; border-radius: 4px;">
    KFO Favorites: Please configure Algolia credentials in the Theme Editor.
  </p>
{% endif %}

{% schema %}
{
  "name": "KFO Favorites",
  "target": "section",
  "settings": [
    {
      "type": "header",
      "content": "Algolia credentials"
    },
    {
      "type": "text",
      "id": "algolia_app_id",
      "label": "Application ID"
    },
    {
      "type": "text",
      "id": "algolia_search_key",
      "label": "Search-Only API Key",
      "info": "Use Search-Only Key — never Admin Key."
    },
    {
      "type": "header",
      "content": "Index"
    },
    {
      "type": "text",
      "id": "combinations_index",
      "label": "Combinations index",
      "default": "kfo_combinations"
    }
  ]
}
{% endschema %}
