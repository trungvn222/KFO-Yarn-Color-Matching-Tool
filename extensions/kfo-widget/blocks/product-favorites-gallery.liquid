<div
  id="kfo-product-favorites"
  data-heart-url="{{ 'kfo-heart.svg' | asset_url }}"
  data-heart-active-url="{{ 'kfo-heart-active.svg' | asset_url }}"
  data-per-page="{{ block.settings.per_page | default: 12 }}"
  {{ block.shopify_attributes }}
></div>

{{ 'kfo-widget.css' | asset_url | stylesheet_tag }}
{% if block.settings.language != blank and block.settings.language != 'auto' %}
  <script>window.KFO_LANG = '{{ block.settings.language }}';</script>
{% endif %}
<script>
  (function () {
    var src = '{{ 'kfo-product-favorites.js' | asset_url }}';

    // A static <script src defer> tag does NOT execute when this section is
    // injected via innerHTML (Shopify Section Rendering API / instant-nav
    // tools like shopify-perf-kit). A <script> created with createElement
    // always executes, so we inject it programmatically instead (same
    // pattern as combinations.liquid).
    if (document.querySelector('script[data-kfo-product-favorites]')) return;
    var s = document.createElement('script');
    s.src = src;
    s.defer = true;
    s.setAttribute('data-kfo-product-favorites', '');
    document.head.appendChild(s);
  })();
</script>

{% schema %}
{
  "name": "KFO Product Favorites",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "select",
      "id": "language",
      "label": "Widget language",
      "options": [
        { "value": "auto", "label": "Auto (detect from storefront)" },
        { "value": "en", "label": "English" },
        { "value": "da", "label": "Danish" }
      ],
      "default": "auto",
      "info": "Auto shows Danish when the storefront language is Danish."
    }
  ]
}
{% endschema %}
