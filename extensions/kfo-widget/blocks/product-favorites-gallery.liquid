<div
  id="kfo-product-favorites"
  data-heart-url="{{ 'kfo-heart.svg' | asset_url }}"
  data-heart-active-url="{{ 'kfo-heart-active.png' | asset_url }}"
  data-per-page="{{ block.settings.per_page | default: 12 }}"
  {{ block.shopify_attributes }}
></div>

{{ 'kfo-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'kfo-product-favorites.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "KFO Product Favorites",
  "target": "section",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "Products per page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
